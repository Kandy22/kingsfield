{
  "effortLevel": "high",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(curl -s http://localhost:3001*)",
      "Bash(curl -s http://localhost:3000*)",
      "Bash(npx tsc *)",
      "Bash(backend/node_modules/.bin/tsc --noEmit -p backend)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "mcp__Claude_Preview__preview_eval",
      "mcp__Claude_Preview__preview_screenshot",
      "mcp__Claude_Preview__preview_start",
      "mcp__Claude_Preview__preview_fill",
      "mcp__Claude_Preview__preview_click",
      "mcp__Claude_Preview__preview_console_logs",
      "mcp__Claude_Preview__preview_snapshot",
      "mcp__Claude_Preview__preview_resize",
      "mcp__Claude_Preview__preview_stop",
      "mcp__Claude_Preview__preview_list",
      "mcp__Claude_Preview__preview_logs",
      "mcp__Claude_Preview__preview_network"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.venv-cascade/bin/python\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce_agent_dirs.py\" || exit 2"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.venv-cascade/bin/python\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require_adversary_signoff.py\" || exit 2",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
