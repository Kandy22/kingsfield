NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Backend API base URL. Leave BLANK to auto-derive from the page host
# (http://<hostname>:3001) — this lets the app be opened from another device on
# the same Wi-Fi (e.g. http://192.168.x.x:3000) with no rebuild. Set an explicit
# value only to override.
NEXT_PUBLIC_API_BASE_URL=

# ── OPTIONAL: GUEST / DEMO LOGIN MODE ─────────────────────────────────────────
# When NEXT_PUBLIC_DEMO_MODE=true, the app skips the login screen and auto-signs
# in as a dedicated throwaway demo account — anyone who opens the link is in.
# Off by default. To enable:
#   1) create the demo account once:  node backend/scripts/create-demo-user.mjs
#   2) set the three vars below (email/password must match the created account)
#   3) restart the frontend
# Turn it back off by setting NEXT_PUBLIC_DEMO_MODE=false and restarting.
# NOTE: while on, the app is ungated — only use on a trusted network for demos.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_EMAIL=demo@kingsfield.app
NEXT_PUBLIC_DEMO_PASSWORD=change-me
